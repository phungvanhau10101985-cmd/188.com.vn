{
  "name": "188-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next-dev.cjs",
    "dev:clean": "node scripts/next-dev.cjs --clean",
    "build": "next build --webpack",
    "start": "node scripts/next-start.cjs",
    "lint": "next lint",
    "clear-cache": "node -e \"const fs=require('fs');['.next','.next-run','node_modules/.cache'].forEach(p=>{try{fs.rmSync(p,{recursive:true,force:true})}catch(e){}})\"",
    "type-check": "tsc --noEmit",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:fulfillment-parity:golden": "python ../tools/order_fulfillment_parity.py --self-test --peer-fixture ../../nanoai.vn/contracts/shared-order-fulfillment-v1.json --peer-tool ../../nanoai.vn/tools/order_fulfillment_parity.py && cd ../backend && python -m pytest tests/test_shared_order_contract_fixtures.py tests/test_optimized_fulfillment_feature.py",
    "test:fulfillment-parity:integration": "python ../tools/run_order_fulfillment_integration_gate.py --peer-root ../../nanoai.vn",
    "test:fulfillment-parity:integration:live": "python ../tools/run_order_fulfillment_integration_gate.py --peer-root ../../nanoai.vn --live"
  },
  "dependencies": {
    "@ant-design/icons": "^5.2.6",
    "@tailwindcss/container-queries": "^0.1.1",
    "antd": "^5.12.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.10",
    "next": "^16.2.6",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^10.3.0",
    "eslint-config-next": "^16.2.6",
    "fastq": "^1.19.0",
    "jest": "^29.0.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "postcss": "$postcss"
  },
  "eslintConfig": {
    "extends": [
      "next/core-web-vitals"
    ]
  }
}
